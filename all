5.Write a program to implement the RSA algorithm.

import javax.crypto.*;
import java.security.*;
import java.util.Scanner;

public class RSADemo {
    public static void main(String[] args) throws Exception {
        Scanner sc = new Scanner(System.in);
        System.out.print("Enter text: ");
        String msg = sc.nextLine();

        KeyPairGenerator k = KeyPairGenerator.getInstance("RSA");
        KeyPair kp = k.generateKeyPair();

        Cipher c = Cipher.getInstance("RSA");
        c.init(Cipher.ENCRYPT_MODE, kp.getPublic());
        byte[] e = c.doFinal(msg.getBytes());
        System.out.println("Encrypted: " + new String(e));

        c.init(Cipher.DECRYPT_MODE, kp.getPrivate());
        byte[] d = c.doFinal(e);
        System.out.println("Decrypted: " + new String(d));
    }
}

