<h2>Diffie-Hellman Key Exchange</h2>

Enter Prime Number (p):
<input type="number" id="p"><br><br>

Enter Generator (g):
<input type="number" id="g"><br><br>

Enter Alice's Private Key:
<input type="number" id="a"><br><br>

Enter Bob's Private Key:
<input type="number" id="b"><br><br>

<button onclick="calculate()">Generate Key</button>

<p id="result"></p>

<script>
function calculate() {

    let p = Number(document.getElementById("p").value);
    let g = Number(document.getElementById("g").value);
    let a = Number(document.getElementById("a").value);
    let b = Number(document.getElementById("b").value);

    let A = (g ** a) % p;
    let B = (g ** b) % p;

    let key1 = (B ** a) % p;
    let key2 = (A ** b) % p;

    document.getElementById("result").innerHTML =
        "Alice's Public Key: " + A + "<br>" +
        "Bob's Public Key: " + B + "<br>" +
        "Alice's Shared Key: " + key1 + "<br>" +
        "Bob's Shared Key: " + key2 + "<br>" +
        "Keys Match: " + (key1 == key2);
}
</script>

