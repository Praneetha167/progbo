7. Calculate the message digest of a text using
a. SHA-512 algorithm.
b. MD5 algorithm.

7a - SHA-512 algorithm

import java.security.MessageDigest;

public class SHA512Demo {
    public static void main(String[] args) throws Exception {
        String text = "Hello world";

        MessageDigest md = MessageDigest.getInstance("SHA-512");
        byte[] data = md.digest(text.getBytes());

        String result = "";
        for (byte b : data) {
            result += String.format("%02x", b & 0xff);
        }

        System.out.println("SHA-512: " + result);
    }
}



