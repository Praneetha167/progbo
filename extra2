2. Write a simple Java program where a client sends text messages to a server. 
The server must change the text to uppercase and send it straight back until the client types "bye" to close the connection.

Server.java
import java.io.*;
import java.net.*;


import java.net.*;
import java.io.*;
import java.util.*;

class Server {
    public static void main(String args[]) throws Exception {

        ServerSocket ss = new ServerSocket(5000);
        System.out.println("Server is waiting...");

        Socket s = ss.accept();
        System.out.println("Client connected.");

        Scanner sc = new Scanner(s.getInputStream());
        DataOutputStream dos = new DataOutputStream(s.getOutputStream());

        String msg;

        while (true) {
            msg = sc.nextLine();

            if (msg.equals("bye")) {
                dos.writeBytes("BYE\n");
                break;
            }

            System.out.println("Client: " + msg);
            dos.writeBytes(msg.toUpperCase() + "\n");
        }

        sc.close();
        dos.close();
        s.close();
        ss.close();
    }
}

import java.net.*;
import java.io.*;
import java.util.*;

class Client {
    public static void main(String args[]) throws Exception {

        Socket s = new Socket("localhost", 5000);

        Scanner server = new Scanner(s.getInputStream());
        DataOutputStream dos = new DataOutputStream(s.getOutputStream());

        Scanner user = new Scanner(System.in);

        String msg;

        do {
            System.out.print("Enter: ");
            msg = user.nextLine();

            dos.writeBytes(msg + "\n");

            System.out.println("Server: " + server.nextLine());

        } while (!msg.equals("bye"));

        server.close();
        user.close();
        dos.close();
        s.close();
    }
}
}
